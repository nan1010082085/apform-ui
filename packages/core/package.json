{
  "name": "@apform-ui/core",
  "version": "1.17.6",
  "type": "module",
  "author": "yangdongnan",
  "license": "MIT",
  "description": "Apform UI：Element Plus 底座包装在本库栈下；el-* 算可用能力，视觉以本库 Design Tokens 为准",
  "keywords": [
    "vue3",
    "ui",
    "component-library",
    "element-plus",
    "schema-platform",
    "design-tokens"
  ],
  "homepage": "https://github.com/nan1010082085/apform-ui",
  "repository": {
    "type": "git",
    "url": "https://github.com/nan1010082085/apform-ui.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/nan1010082085/apform-ui/issues"
  },
  "_ep_fork_base": "2.14.2",
  "_ep_fork_date": "2026-08-27",
  "main": "./dist/apform-ui.umd.cjs",
  "module": "./dist/apform-ui.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/apform-ui.js",
      "require": "./dist/apform-ui.umd.cjs"
    },
    "./chat": {
      "types": "./dist/chat.d.ts",
      "import": "./dist/chat.js",
      "require": "./dist/chat.umd.cjs"
    },
    "./bpmn": {
      "types": "./dist/bpmn.d.ts",
      "import": "./dist/bpmn.js",
      "require": "./dist/bpmn.umd.cjs"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./design-tokens.css": "./src/tokens/design-tokens.css",
    "./style.css": "./dist/apform-ui.css",
    "./chat.css": "./dist/chat.css",
    "./bpmn.css": "./dist/bpmn.css",
    "./styles/element-override.css": "./styles/element-override.css",
    "./styles/fg-theme.css": "./styles/fg-theme.css",
    "./theme/*": "./src/theme/*",
    "./styles/*": "./styles/*",
    "./docs": "./src/docs/index.ts"
  },
  "files": [
    "dist",
    "src/tokens",
    "src/theme",
    "src/docs",
    "styles",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build -c vite.chat.config.ts && vite build -c vite.bpmn.config.ts",
    "build:check": "vue-tsc --noEmit && pnpm run build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@vue-flow/background": ">=1.3.0",
    "@vue-flow/controls": ">=1.1.0",
    "@vue-flow/core": ">=1.48.0",
    "echarts": ">=5.0.0",
    "element-plus": "2.14.2",
    "pdfjs-dist": ">=4.0.0",
    "vue": "^3.5.0",
    "vue-virtual-scroller": ">=2.0.0-beta.0",
    "xlsx": ">=0.18.0"
  },
  "peerDependenciesMeta": {
    "@vue-flow/background": {
      "optional": true
    },
    "@vue-flow/controls": {
      "optional": true
    },
    "@vue-flow/core": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "pdfjs-dist": {
      "optional": true
    },
    "vue-virtual-scroller": {
      "optional": true
    },
    "xlsx": {
      "optional": true
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify-icons/ep": "^1.2.0",
    "@iconify/vue": "^5.0.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11"
  },
  "devDependencies": {
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vue/test-utils": "^2.4.6",
    "echarts": "^5.6.0",
    "element-plus": "2.14.2",
    "jsdom": "^26.0.0",
    "sass-embedded": "^1.100.0",
    "typescript": "~5.7.3",
    "vite": "^6.3.2",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^3.2.1",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8",
    "vue-virtual-scroller": "2.0.0-beta.8"
  }
}
