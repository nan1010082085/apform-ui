  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "vite build",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "@iconify/vue": "^5.0.0"
  },
  "dependencies": {
    "@iconify-icons/ep": "^1.2.13"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "typescript": "~5.7.3",
    "vite": "^6.3.2"
  }
}
