{
  "name": "@apform-ui/monorepo",
  "private": true,
  "version": "1.22.6",
  "description": "Schema Platform UI 组件库 monorepo",
  "author": "yangdongnan",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "build": "pnpm -r run build",
    "build:core": "pnpm --filter @apform-ui/core run build",
    "test": "pnpm -r run test",
    "docs:dev": "pnpm --filter @apform-ui/playground dev",
    "docs:build": "pnpm --filter @apform-ui/playground build",
    "docs:deploy": "bash scripts/deploy-to-pyflow.sh",
    "docs:verify": "node scripts/verify-live-docs.mjs",
    "clean": "pnpm -r run clean",
    "release": "bash scripts/publish-with-docs.sh",
    "publish:core": "bash scripts/publish-with-docs.sh",
    "gate": "pnpm run check:version && pnpm run gate:core && pnpm run scan:sensitive && pnpm run check:visual && pnpm run check:shallow-docs && pnpm run docs:build",
    "gate:core": "pnpm run check:version && pnpm --filter @apform-ui/core run build:check && pnpm --filter @apform-ui/core test",
    "scan:sensitive": "node scripts/scan-sensitive.mjs",
    "check:visual": "node scripts/check-visual-rules.mjs",
    "check:shallow-docs": "node scripts/check-shallow-docs.mjs",
    "verify:pack": "node scripts/verify-pack-install.mjs",
    "css:size": "node scripts/css-size-report.mjs",
    "check:version": "node scripts/check-version-sync.mjs",
    "audit:high": "pnpm audit --audit-level=high",
    "tree-shake:baseline": "node scripts/tree-shake-baseline.mjs",
    "check:core": "bash scripts/pre-publish-check.sh core",
    "check:utils": "bash scripts/pre-publish-check.sh utils",
    "check:icons": "bash scripts/pre-publish-check.sh icons",
    "check:themes": "bash scripts/pre-publish-check.sh themes",
    "check:plugins": "bash scripts/pre-publish-check.sh plugins",
    "bump:patch": "node ../scripts/release-bump.mjs --project apform-ui --type patch",
    "bump:minor": "node ../scripts/release-bump.mjs --project apform-ui --type minor"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@iconify-icons/ep": "^2.0.0"
  },
  "devDependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "@iconify/vue": "^5.0.1",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "3.2.7",
    "element-plus": "2.14.2",
    "playwright": "latest",
    "vite": "^6.3.2",
    "vitest": "3.2.7",
    "vue": "^3.5.13"
  }
}
